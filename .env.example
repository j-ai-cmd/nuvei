# ============================================================
# Legal AI Contract Intake — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# Set these as Vercel Environment Variables for production.

# AI Analysis Provider (server-side only — never exposed to browser)
# Required for real-time AI contract analysis.
# If unset, the app falls back to pre-computed DEMO DATA.
KIMI_API_KEY=

# AI model to use.
# Verify available models in your account console before deploying.
# Common options (check console for availability):
#   moonshot-v1-8k   — faster, lower cost, suitable for most contracts
#   moonshot-v1-32k  — handles longer contracts (recommended)
#   moonshot-v1-128k — for very long or complex multi-part agreements
KIMI_MODEL=
